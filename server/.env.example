# Backend Environment Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/driveaway?retryWrites=true&w=majority
MONGO_URI=your_mongodb_atlas_connection_string

# JWT Secret & Expiry
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Frontend client URL for CORS (your Vercel URL)
CLIENT_URL=https://your-driveaway.vercel.app

# Email (optional). Use ONE of these:
#  a) Brevo API (works everywhere, required on Render's free plan, which blocks SMTP)
BREVO_API_KEY=
EMAIL_FROM=you@example.com
#  b) Gmail SMTP (works on your own computer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
# Optional: where contact-form messages go (defaults to the sender address)
EMAIL_TEAM=

# Optional: only Vercel preview URLs whose hostname starts with this prefix are allowed by CORS
# (CLIENT_URL is always allowed). Default: driveaway
VERCEL_PROJECT_PREFIX=driveaway

# Optional: public URL of this API, used to build links to uploaded car photos.
# Normally detected automatically; set it if uploads show the wrong host.
# PUBLIC_API_URL=https://driveaway-api.onrender.com

# Optional: passwords for the accounts `npm run seed` creates (random if left empty)
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
