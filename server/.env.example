# Backend Environment Configuration
# Copy to server/.env for local development. On Render these are set in render.yaml / the dashboard.
PORT=5000
# development locally; Render sets production itself. Outside production, password reset links are
# also printed in the server console, so they work without email.
NODE_ENV=development

# MongoDB connection string (MONGODB_URI is accepted too). The server will not start without it.
# Local by default; on Render use your Atlas string, e.g.
# mongodb+srv://<username>:<password>@cluster0.mongodb.net/driveaway?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/driveaway

# JWT secret: required, at least 16 characters (the server refuses to start otherwise). Make one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# It also signs the unsubscribe links in offer emails, so changing it signs everyone out and
# invalidates links already sent. Render generates its own.
JWT_SECRET=
JWT_EXPIRE=7d

# The website's URL: allowed by CORS and used for links in emails (password reset, alerts, offers).
# Comma-separate several sites. Leave empty locally (links then use http://localhost:5173).
# Example: CLIENT_URL=https://your-driveaway.vercel.app
CLIENT_URL=

# Email (optional; leave all empty and email is simply off). Use ONE of these:
#  a) Brevo API (works everywhere, required on Render's free plan, which blocks SMTP)
#     BREVO_API_KEY from Brevo > SMTP & API > API keys; EMAIL_FROM = a sender verified in Brevo
BREVO_API_KEY=
EMAIL_FROM=
#  b) Gmail SMTP (works on your own computer): your Gmail address and a Gmail app password.
#     EMAIL_FROM is optional here (defaults to EMAIL_USER).
EMAIL_USER=
EMAIL_PASS=
# Optional: where contact-form messages go (defaults to the sender address)
EMAIL_TEAM=

# Optional: https://<VERCEL_PROJECT_PREFIX>.vercel.app is allowed by CORS (CLIENT_URL always is).
# Default: driveaway
VERCEL_PROJECT_PREFIX=driveaway
# Optional: also allow this project's Vercel preview deployments. Set it to "-<your-team-slug>.vercel.app";
# previews must then match https://<prefix>-<anything>-<your-team-slug>.vercel.app exactly.
# Leave empty unless previews must reach the API: anyone can name a Vercel project to look like
# a preview URL, so this is weaker than listing exact sites in CLIENT_URL.
VERCEL_PREVIEW_SUFFIX=

# Optional: public URL of this API, used to build links to uploaded car photos and unsubscribe links.
# Normally detected from the request; set it if links show the wrong host.
# PUBLIC_API_URL=https://driveaway-api.onrender.com

# Tests (`npm test`) use their own database, so they never touch your real data.
# The database name must contain "test"; a non-local host is refused unless ALLOW_REMOTE_TEST_DB=yes.
# TEST_MONGO_URI=mongodb://127.0.0.1:27017/driveaway_test
# ALLOW_REMOTE_TEST_DB=
# Port for the server the tests start (a free port is picked when empty)
# TEST_PORT=

# Optional: passwords for the accounts `npm run seed` creates (random if left empty)
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
# The seed refuses to wipe a database that has users or bookings, or any non-empty remote database,
# unless SEED_CONFIRM equals that database's name. Set it only for the one run, never here permanently.
# SEED_CONFIRM=

# RENDER is set by Render itself (used to warn that Gmail SMTP is blocked there); don't set it here.
