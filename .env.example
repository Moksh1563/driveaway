# Production Backend API URL (without trailing slash, e.g. https://your-backend.onrender.com/api)
VITE_API_BASE_URL=https://your-backend.onrender.com/api

# Show the "Demo accounts" quick-login buttons on the deployed site (true/false).
# Off by default: they let anyone sign in as the seeded admin.
VITE_SHOW_DEMO_LOGINS=false
