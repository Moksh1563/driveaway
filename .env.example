# Frontend (Vite) environment. Local development needs no root .env: the site calls /api and
# Vite forwards it to the API on http://localhost:5000 (see vite.config.js).
# On Vercel, set these under Project > Settings > Environment Variables. Vite bakes them into the
# build, so changing one needs a redeploy.

# Backend API URL with /api and no trailing slash, e.g. https://your-backend.onrender.com/api
# Empty = /api on the same site. vercel.json's Content-Security-Policy only allows API calls to
# https://*.onrender.com; an API on another host needs its connect-src updated.
VITE_API_BASE_URL=

# Optional: public website address for WhatsApp invoice messages built in the browser, which happens
# only when the API can't build one (the API uses its CLIENT_URL). e.g. https://your-site.vercel.app
# Empty = the address the site is opened on
VITE_SITE_URL=
